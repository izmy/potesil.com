---
// Ručně vybrané aktivity ze Stravy. Pořadí v poli = pořadí na webu.
// `id` je číslo z adresy aktivity: https://www.strava.com/activities/<id>
const highlights: {
  id: string;
  sport: "run" | "ride";
  title: string;
  km: number;
  date: string;
  time: string;
  elevation?: number;
  quote: string;
}[] = [
  {
    id: "16604486763",
    sport: "run",
    title: "Z Holešovic do Vlašimi",
    km: 100,
    date: "11/2025",
    time: "10:51 h",
    elevation: 3178,
    quote: "Nejdelší běh v mym životě a asi to jen tak něco nepřekoná.",
  },
  {
    id: "19475528838",
    sport: "ride",
    title: "K jezeru Most na buchtičky",
    km: 210,
    date: "7/2026",
    time: "7:56 h",
    elevation: 2201,
    quote: "Jen já a plnej dres různejch gelů, který jsem stejně dovezl zpátky.",
  },
  {
    id: "19955148790",
    sport: "ride",
    title: "Stoneman za dva dny",
    km: 302,
    date: "8/2026",
    time: "14:35 h",
    elevation: 5735,
    quote: "Byl to boj. Boj, kterej jsme vyhráli.",
  },
  {
    id: "20712101676",
    sport: "run",
    title: "Z Tróji na Karlštejn",
    km: 45,
    date: "10/2026",
    time: "4:11 h",
    elevation: 206,
    quote: "Trasa místy divoká, ale krásná. Ideální sobota.",
  },
  {
    id: "16739068670",
    sport: "run",
    title: "Maraton Málaga",
    km: 42.2,
    date: "12/2025",
    time: "3:15:26",
    quote: "Forma je. Cítím to v kostech.",
  },
  {
    id: "13721340992",
    sport: "run",
    title: "Na Vesuv a zpátky",
    km: 27,
    date: "2/2025",
    time: "2:48 h",
    elevation: 1140,
    quote: "Místama mi to moc nechutnalo, ale pocit po doběhnutí k nezaplacení.",
  },
];

const num = new Intl.NumberFormat("cs-CZ", { maximumFractionDigits: 1 });

// Poslední slovo drží pohromadě s ikonkou, aby nezůstala sama na řádku.
const splitTitle = (title: string) => {
  const i = title.lastIndexOf(" ");
  return i === -1 ? ["", title] : [title.slice(0, i + 1), title.slice(i + 1)];
};
---

<section id="strava-highlights" aria-label="Nejdelší běhy a vyjížďky">
  <ol class="tiles">
    {
      highlights.map((h) => {
        const [head, last] = splitTitle(h.title);
        const meta = [
          h.date,
          h.time,
          h.elevation && `${num.format(h.elevation)} m ↑`,
        ].filter(Boolean);

        return (
          <li>
            <a
              class="tile"
              href={`https://www.strava.com/activities/${h.id}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${h.title} – Strava (otevře se v novém okně)`}
            >
              <div class="top">
                <span class="km">
                  {num.format(h.km)}
                  <small>km</small>
                </span>
                {h.sport === "run" ? (
                  <svg class="sport" viewBox="0 0 24 24" role="img" aria-label="Běh">
                    <title>Běh</title>
                    <circle cx="15.2" cy="4.2" r="1.7" />
                    <path d="M13.4 7.6 11 13.2M13.4 7.6 10.2 9.4 8.6 8M13.4 7.6 15.6 10.4 18 9.6M11 13.2 14 15.4 12.8 20M11 13.2 9 16.6 5.4 17" />
                  </svg>
                ) : (
                  <svg class="sport" viewBox="0 0 24 24" role="img" aria-label="Kolo">
                    <title>Kolo</title>
                    <circle cx="4.8" cy="16.6" r="4" />
                    <circle cx="19.2" cy="16.6" r="4" />
                    <path d="M4.8 16.6h6.4L9.2 9.4zM9.2 9.4 16.4 9.9M11.2 16.6 16.7 11M16 8.4 19.2 16.6M7.6 8h3.4M9.2 8v1.4M16 8.4h2.1c1 0 1.5.6 1.5 1.4v.6c0 .8-.6 1.3-1.4 1.3h-.5" />
                  </svg>
                )}
              </div>
              {/* bez zalomení řádků, jinak by mezery prosvítaly ve žlutém podbarvení */}
              <p class="title">
                <span>{head}<span class="nowrap">{last}<i class="fa-sharp fa-regular fa-arrow-up-right-from-square" aria-hidden="true"></i></span></span>
              </p>
              <p class="meta">{meta.join(" · ")}</p>
              <p class="quote">„{h.quote}“</p>
            </a>
          </li>
        );
      })
    }
  </ol>
</section>

<style lang="scss">
  @use "../../styles" as *;

  $teal: #3b777a;
  $muted: #6b6b6b;

  section {
    padding: 2rem 1rem 3rem;
  }

  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;

    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
  }

  .tile {
    display: block;
    height: 100%;
    color: #000;
    text-decoration: none;

    &:hover .title > span {
      text-decoration: underline;
    }

    &:hover .sport {
      color: $teal;
      opacity: 1;
      transform: translateX(4px);
    }

    &:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 4px;
    }
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: start;
  }

  .km {
    @include gradient-heading($gradient-hobbies);

    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 2.3rem;
    line-height: 0.95;
    letter-spacing: -0.045em;

    small {
      font-size: 0.32em;
      font-weight: 300;
      letter-spacing: 0;
    }
  }

  .sport {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;

    color: $muted;
    opacity: 0.7;
    transition:
      transform 0.25s,
      color 0.25s;
  }

  .title {
    margin: 0.7rem 0 0.25rem;
    font-weight: 300;
    font-size: 1.2rem;
    line-height: 1.45;

    > span {
      background: $yellow;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }

    .nowrap {
      white-space: nowrap;
    }

    i {
      font-size: 0.5em;
      padding-inline: 0.5rem;
      vertical-align: super;
    }
  }

  .meta {
    margin: 0;
    font-weight: 300;
    font-size: 0.78rem;
    color: $muted;
  }

  .quote {
    margin: 0.6rem 0 0;
    font-weight: 300;
    font-style: italic;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  @media (min-width: $breakpoint-md) {
    section {
      padding: 3rem 2rem 5rem;
    }

    .km {
      font-size: clamp(2.5rem, 4.5vw, 4.25rem);
    }

    .sport {
      width: 1.7rem;
      height: 1.7rem;
    }

    .meta {
      font-size: 0.85rem;
    }

    .quote {
      font-size: 0.9rem;
    }
  }

  @media (min-width: 60rem) {
    .tiles {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem 3rem;
    }
  }

  @media (min-width: $breakpoint-xl) {
    section {
      max-width: $container-max;
      margin-inline: auto;
    }
  }
</style>
